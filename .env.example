# Copy to .env for local dev. .env is gitignored, so these must ALSO be set in
# Netlify: Site configuration → Environment variables (scope: Builds).
# Vite inlines VITE_* at build time — adding one later requires a redeploy.

# Customer backend: auth (token refresh) + the admin surface (custom token,
# compliance duplicate matching).
VITE_BASE_URL=https://backend.alphacapitalgroup.uk/

# Risk engine: every /api/* surveillance endpoint — overview, account search,
# flags, the six detection models, daily report, payouts, reviews.
VITE_RISK_API_BASE=https://risk-engine-dev.alphacapitalgroup.uk
