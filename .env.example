# Copy to .env for local dev. .env is gitignored, so these must ALSO be set in
# Netlify: Site configuration → Environment variables (scope: Builds).
# Vite inlines VITE_* at build time — adding one later requires a redeploy.

# Customer backend: auth (token refresh) + the admin surface (custom token,
# compliance duplicate matching).
VITE_BASE_URL=https://backend.alphacapitalgroup.uk/

# Risk engine: every /api/* surveillance endpoint — overview, account search,
# flags, the six detection models, daily report, payouts, reviews.
VITE_RISK_API_BASE=https://risk-engine-dev.alphacapitalgroup.uk

# Dash API: the Custom Dash tab's catalogue, version history and view URLs.
# Called straight from the browser, so this host must allow the app's origin
# via CORS and must appear in connect-src in netlify.toml.
#
# The value INCLUDES the API's own prefix — it ends in /v1/dash, and the client
# appends only /catalogue, /<slug>/versions and /<slug>/view-url.
VITE_RISK_CUSTOM_DASH_BASE=https://alpharisk-dash-api.swarnab.workers.dev/v1/dash

# The dash READ key, never the publish key. VITE_* is inlined into the bundle,
# so this ships in plain text to every visitor — treat it as a PUBLIC
# credential: anyone who can load the app can read anything it can read. Rotate
# it here (and redeploy) rather than assuming it stays secret.
VITE_DASH_READ_KEY=

# The viewer Worker that serves dashboard bundles into the iframe is a separate
# host, https://alpharisk-dash-view.swarnab.workers.dev, and is not configured
# here — it arrives in each view-url response. It must appear in frame-src in
# netlify.toml, and its own APP_ORIGIN must name this app's origin.
